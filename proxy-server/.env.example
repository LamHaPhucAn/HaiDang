# Sao chép file này thành ".env" khi chạy ở máy local để test.
# Trên Render, KHÔNG tạo file .env — thay vào đó nhập từng biến vào mục Environment Variables.
# TUYỆT ĐỐI không commit file ".env" thật (có giá trị thật) lên GitHub.

# Lấy key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chuỗi bí mật để mã hóa phiên đăng nhập — tự đặt một chuỗi dài, ngẫu nhiên, không chia sẻ cho ai.
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-bi-mat-that-dai-va-ngau-nhien

# Tài khoản quản trị viên (admin) đầu tiên, tự động tạo khi server khởi động lần đầu.
ADMIN_EMAIL=admin@haidang.vn
ADMIN_PASSWORD=Admin@123
